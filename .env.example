# ════════════════════════════════════════════════════════════════
# Zender237 — Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copy this file to backend/.env and frontend/.env (or set in Render dashboard).
# The app works in DEMO mode (in-memory, seeded data) when DATABASE_URL is empty.
# Set DATABASE_URL to a real PostgreSQL connection string to use the database.
#
# ─── Backend (backend/.env) ───────────────────────────────────────

# Server
PORT=8090
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL (leave empty for demo/in-memory mode)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Admin WhatsApp contact (used for borrow/chat/diaspora redirects; editable in admin Settings)
ADMIN_WHATSAPP=+237700000001

# Firebase Admin SDK (FCM push notifications + Storage for receipts)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=zender237-309ae
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@zender237-309ae.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET=zender237-309ae.firebasestorage.app

# Firebase Web SDK config (exposed to frontend via /api/config endpoint)
FIREBASE_API_KEY=AIzaSyDnNn5UzUwCEG4Aazypz0qXjgG_pdWZpBc
FIREBASE_AUTH_DOMAIN=zender237-309ae.firebaseapp.com
FIREBASE_APP_ID=1:450126459846:web:915275a67657933e8478c7
FIREBASE_MESSAGING_SENDER_ID=450126459846
FIREBASE_MEASUREMENT_ID=G-71LC8B2X0L

# ─── Frontend (frontend/.env) ─────────────────────────────────────
# API base URL — in development, Vite proxies /api to the backend automatically.
# In production (Render), set this to your backend's public URL.
VITE_API_URL=http://localhost:8090/api
